# SQLite metadata and job state
DATABASE_URL=file:./data/photo-library.db
SQLITE_BUSY_TIMEOUT_MS=5000

# RustFS S3-compatible object storage (private bucket)
RUSTFS_ENDPOINT=http://localhost:9000/photo-library
RUSTFS_REGION=us-east-1
RUSTFS_BUCKET=photo-library
RUSTFS_ACCESS_KEY_ID=devaccess
RUSTFS_SECRET_ACCESS_KEY=devsecret
RUSTFS_PRESIGN_SECONDS=300

# Bounded disposable local data
DERIVATIVE_CACHE_PATH=./data/cache
DERIVATIVE_CACHE_MAX_BYTES=2147483648
DERIVATIVE_CACHE_HIGH_WATER_BYTES=2415919104
DERIVATIVE_CACHE_TARGET_BYTES=1879048192
MEDIA_TMP_PATH=./data/tmp

# Image safety limits
MEDIA_MAX_BYTES=104857600
MEDIA_MAX_PIXELS=100000000
MEDIA_MAX_ATTEMPTS=3
MEDIA_JOB_LEASE_SECONDS=120

# Pocket ID OIDC
OIDC_ISSUER=https://pocket-id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:4000/auth/callback
OIDC_ALLOWED_SUBJECTS=
OIDC_ALLOWED_GROUPS=
OIDC_SESSION_LIFETIME_SECONDS=28800
OIDC_COOKIE_NAME=photo_library_session
OIDC_COOKIE_SECURE=false

# Explicit local-only admin session bypass; ignored outside development
DEV_AUTH_BYPASS=false
