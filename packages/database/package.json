{
  "name": "database",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "src/index.ts",
  "type": "module",
  "scripts": {
    "build": "tsup ./src/index.ts --format esm --external ../prisma/generated/client",
    "dev": "tsup ./src/index.ts --format esm --external ../prisma/generated/client --watch",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:push": "prisma db push",
    "format": "prisma format",
    "generate": "prisma generate",
    "prebuild": "pnpm run generate",
    "predev": "pnpm run generate",
    "studio": "prisma studio",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.9.1",
    "@prisma/client": "7.9.1",
    "better-sqlite3": "13.0.3",
    "config": "workspace:*",
    "dotenv": "17.4.2"
  },
  "devDependencies": {
    "prisma": "7.9.1",
    "@types/better-sqlite3": "7.6.13",
    "tsconfig": "workspace:*",
    "tsup": "8.5.1"
  }
}
