datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
  output   = "./generated/client"
}

model Album {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  description String?
  published   Boolean      @default(false)
  publishedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  media       AlbumMedia[]

  @@index([published, updatedAt])
}

model MediaAsset {
  id             String       @id @default(cuid())
  originalKey    String       @unique
  originalName   String
  originalMime   String
  originalBytes  Int
  width          Int
  height         Int
  status         MediaStatus  @default(pending)
  safeError      String?
  createdBy      String
  createdAt      DateTime     @default(now())
  capturedAt     DateTime?
  updatedAt      DateTime     @updatedAt
  albumLinks     AlbumMedia[]
  derivatives    Derivative[]
  uploadIntent   UploadIntent?
  jobs           MediaJob[]

  @@index([status, createdAt])
  @@index([capturedAt])
}

model AlbumMedia {
  albumId   String
  mediaId   String
  position  Int
  featured  Boolean    @default(false)
  album     Album      @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([albumId, mediaId])
  @@unique([albumId, position])
  @@index([albumId, featured, position])
}

model Derivative {
  id         String            @id @default(cuid())
  mediaId    String
  format     DerivativeFormat
  width      Int
  height     Int
  version    String
  objectKey  String            @unique
  bytes      Int
  createdAt  DateTime          @default(now())
  media      MediaAsset        @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, format, width, version])
  @@index([mediaId, format, width])
}

model UploadIntent {
  id             String             @id @default(cuid())
  mediaId        String?            @unique
  objectKey      String             @unique
  originalName   String
  expectedMime   String
  expectedBytes  Int
  status         UploadIntentStatus @default(pending)
  targetAlbumId  String?
  assignmentStatus AssignmentStatus @default(not_requested)
  assignmentError String?
  expiresAt      DateTime
  completedAt    DateTime?
  createdBy      String
  createdAt      DateTime           @default(now())
  media          MediaAsset?        @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([targetAlbumId, assignmentStatus])
}

model MediaJob {
  id             String        @id @default(cuid())
  mediaId        String
  kind           String
  status         MediaJobStatus @default(pending)
  attempts       Int           @default(0)
  maxAttempts    Int           @default(3)
  availableAt    DateTime      @default(now())
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  safeError      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  media          MediaAsset    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([mediaId, kind])
  @@index([status, availableAt])
  @@index([status, leaseExpiresAt])
}

model AdminSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  subject    String
  groupsJson String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([expiresAt, revokedAt])
}

enum MediaStatus {
  pending
  processing
  ready
  failed
}

enum UploadIntentStatus {
  pending
  completed
  expired
  failed
}

enum AssignmentStatus {
  not_requested
  pending
  added
  unavailable
}

enum MediaJobStatus {
  pending
  processing
  completed
  failed
}

enum DerivativeFormat {
  jxl
  avif
  heic
  webp
  jpeg
}
