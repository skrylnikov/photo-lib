{
  "name": "config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "tsup ./src/index.ts --format esm",
    "dev": "tsup ./src/index.ts --format esm --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsconfig": "workspace:*",
    "tsup": "8.5.1"
  },
  "dependencies": {
    "dotenv": "17.4.2"
  }
}
